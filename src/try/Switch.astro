---
const { at } = Astro.props;
const opts = [['A', '/try/a'], ['B', '/try/b'], ['C', '/try/c'], ['D', '/try/d'], ['E', '/try/e'], ['F', '/try/f'], ['Current', '/']];
---
<nav class="trial-switch" aria-label="Design options">
  {opts.map(([l, h]) => <a href={h} class={l === at ? 'on' : ''}>{l}</a>)}
</nav>
<style>
  .trial-switch { position: fixed; right: 14px; bottom: 14px; z-index: 50; display: flex; gap: 2px; padding: 4px; background: #111; border-radius: 8px; font: 13px/1 system-ui, sans-serif; box-shadow: 0 2px 10px rgba(0, 0, 0, .35); }
  .trial-switch a { padding: 7px 10px; color: #bbb; text-decoration: none; border-radius: 5px; }
  .trial-switch a.on { background: #fff; color: #111; }
</style>
