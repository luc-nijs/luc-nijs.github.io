---
const photos = [
  ['01', 'Luc Nijs smiling, holding a clarinet', '50% 12%', ''],
  ['10', 'Luc Nijs playing clarinet on stage', '60% 20%', ''],
  ['03', 'Luc Nijs playing clarinet wearing an EEG cap', '50% 20%', ''],
  ['08', 'Luc Nijs in front of a red curtain', '50% 15%', 'Gentse Feesten'],
  ['14', 'Luc Nijs in a motion capture session', '70% 40%', ''],
  ['09', 'Luc Nijs playing clarinet outdoors', '40% 30%', 'Bretagne'],
  ['07', 'Luc Nijs giving a talk', '50% 20%', 'Amsterdam'],
  ['04', 'Luc Nijs playing clarinet in stage light', '50% 10%', ''],
  ['15', 'Luc Nijs lecturing', '30% 30%', ''],
  ['13', 'Luc Nijs playing clarinet on stage', '50% 25%', ''],
  ['05', 'Luc Nijs playing clarinet at a music stand', '50% 5%', ''],
  ['11', 'Hands on a clarinet', '50% 50%', ''],
];
---
<div class="fade" data-fade>
  {photos.map(([n, alt, pos, cap], i) => (
    <figure class={i === 0 ? 'on' : ''}>
      <img {...(i === 0 ? { src: `/images/hero/${n}.jpg` } : { 'data-src': `/images/hero/${n}.jpg` })} alt={alt} style={`object-position:${pos}`} />
      {cap && <figcaption>{cap}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .fade { position: relative; overflow: hidden; background: #1b1b1f; }
  figure { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.8s ease-in-out; }
  figure.on { opacity: 1; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { position: absolute; right: 12px; bottom: 10px; z-index: 4; color: #fff; font: 400 13px/1 system-ui, sans-serif; text-shadow: 0 1px 4px rgba(0, 0, 0, .8); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-fade]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduced) {
    const slides = [...root.querySelectorAll<HTMLElement>('figure')];
    let i = 0;
    const ready = (n: number) => {
      const img = slides[n].querySelector('img')!;
      if (img.dataset.src && !img.getAttribute('src')) img.src = img.dataset.src;
      return img.decode();
    };
    window.addEventListener('load', () => {
      ready(1).catch(() => {});
      setInterval(async () => {
        const next = (i + 1) % slides.length;
        try {
          await ready(next);
        } catch {
          return;
        }
        slides[i].classList.remove('on');
        slides[next].classList.add('on');
        i = next;
        ready((next + 1) % slides.length).catch(() => {});
      }, 6000);
    });
  }
</script>
