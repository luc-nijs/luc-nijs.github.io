---
import Base from '../layouts/Base.astro';
---
<Base title={"Contact | Luc Nijs"} description={"Contact Luc Nijs, Associate Professor at the University of Luxembourg, in Esch-sur-Alzette, Luxembourg."} slug="contact-me">
<section style="padding:61px 16px 18px"><div class="inner" style="max-width:980px">
<div class="b" style="margin-left:4.90%;width:43.78%"><div class="rt"><h1 class="fs-28 c-27223e">CONTACT INFORMATION</h1></div></div>
<div class="b" style="margin-left:4.90%;width:13.88%;margin-top:9px"><hr></div>
<div class="b" style="margin-left:4.90%;width:28.57%;margin-top:13px"><div class="rt"><h6 class="fs-23 c-27223e"><strong><em>University of Luxembourg</em></strong></h6></div></div>
</div></section>
<section style="padding:19px 16px 12px"><div class="inner" style="max-width:980px">
<div class="row" style="margin-left:4.90%;width:84.08%">
<div class="col" style="width:38.83%">
<div class="b" style=""><div class="rt"><p class="fs-18 c-27223e lh-140"><strong>Office:</strong></p>
<p class="fs-18 c-27223e lh-140">&nbsp;</p>
<p class="fs-18 c-27223e">11 Prte des Sciences, 4366 Esch-Belval</p>
<p class="fs-18 c-27223e">&nbsp;</p>
<p class="fs-18 c-27223e">Esch-sur-Alzette, Luxembourg</p></div></div>
</div>
<div class="col" style="width:55.34%;margin-left:5.83%">
<div class="b" style="margin-top:6px"><form class="contact-form" data-contact>
<input type="text" name="name" placeholder="Name*" aria-label="Name*" required>
<input type="email" name="email" placeholder="Email address*" aria-label="Email address*" required>
<input type="text" name="subject" placeholder="Subject" aria-label="Subject">
<textarea name="message" placeholder="Message*" aria-label="Message*" rows="6" required></textarea>
<button type="submit">Send</button>
<p class="form-note" data-note hidden></p>
</form></div>
</div>
</div>
</div></section>
<script>
  const TO = 'luc.nijs@uni.lu';
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const note = document.querySelector<HTMLElement>('[data-note]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const topic = String(data.get('subject') || '').trim();
    const body = [
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      ...(topic ? [`Subject: ${topic}`] : []),
      '',
      String(data.get('message')),
    ].join('\n');
    const url = `mailto:${TO}?subject=${encodeURIComponent('via website')}&body=${encodeURIComponent(body)}`;
    if (note) {
      note.hidden = false;
      note.innerHTML = 'Your email program should open with this message, ready to send. If it doesn\u2019t, <a data-link>open it here</a> or write to ' + TO + '.';
      note.querySelector('a')?.setAttribute('href', url);
    }
    window.location.href = url;
  });
</script>
</Base>
