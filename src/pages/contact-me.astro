---
import Base from '../layouts/Base.astro';
---
<Base title={"Contact Me | luc nijs"} description={""} slug="contact-me" bg="rgb(245, 245, 245)">
<section style="padding:61px 16px 18px"><div class="inner" style="max-width:980px">
<div class="b" style="margin-left:4.90%;width:43.78%"><div class="rt"><h2 class="ff-sans fs-28 c-27223e">CONTACT INFORMATION</h2></div></div>
<div class="b" style="margin-left:4.90%;width:13.88%;margin-top:9px"><hr style="border-top:2px solid rgb(39, 34, 62)"></div>
<div class="b" style="margin-left:4.90%;width:28.57%;margin-top:13px"><div class="rt"><h6 class="ff-serif fs-23 c-27223e"><strong><em>University of Luxembourg</em></strong></h6></div></div>
</div></section>
<section style="padding:19px 16px 12px"><div class="inner" style="max-width:980px">
<div class="row" style="margin-left:4.90%;width:84.08%">
<div class="col" style="width:38.83%">
<div class="b" style=""><div class="rt"><p class="ff-serif fs-18 c-27223e lh-140"><strong>Office:</strong></p>
<p class="ff-serif fs-18 c-27223e lh-140">&nbsp;</p>
<p class="ff-serif fs-18 c-27223e">11 Prte des Sciences, 4366 Esch-Belval</p>
<p class="ff-serif fs-18 c-27223e">&nbsp;</p>
<p class="ff-serif fs-18 c-27223e">Esch-sur-Alzette, Luxembourg</p></div></div>
</div>
<div class="col" style="width:55.34%;margin-left:5.83%">
<div class="b" style="margin-top:6px"><form class="contact-form" onsubmit="return false">
<input type="text" name="name" placeholder="Name*" aria-label="Name*" required>
<input type="email" name="email" placeholder="Email address*" aria-label="Email address*" required>
<input type="text" name="subject" placeholder="Subject" aria-label="Subject">
<textarea name="message" placeholder="Bericht" aria-label="Bericht" rows="6"></textarea>
<button type="submit" disabled title="Form not connected yet">Send</button>
</form></div>
</div>
</div>
</div></section>
</Base>
