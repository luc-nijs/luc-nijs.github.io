---
import Switch from '../../try/Switch.astro';
import { nav, lead, intro, news, lectures, links, portrait, photos } from '../../try/content.js';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Option C: Bold colour</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
<style is:global>
  :root { --violet: #27223e; --lav: #cac7da; --pale: #eeedf3; --lime: #d7da4e; --text: #27223e; --soft: #5e5a70; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: var(--text); font: 400 18px/1.55 "Source Sans 3", system-ui, sans-serif; }
  a { color: inherit; text-underline-offset: 3px; }
  img { display: block; width: 100%; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .band { background: var(--violet); color: #fff; }
  header.top { display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: space-between; align-items: baseline; padding-block: 22px; }
  .tag { font-size: 14px; opacity: .75; letter-spacing: .03em; }
  .menu { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 15px; }
  .menu a { text-decoration: none; }
  .menu a:hover { color: var(--lime); }
  .hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 56px; align-items: end; padding-top: 44px; }
  .name { display: block; margin: 0 0 22px; font: 700 clamp(64px, 11.5vw, 148px)/.92 "Bricolage Grotesque", sans-serif; letter-spacing: -.035em; color: var(--lime); text-decoration: none; }
  h1 { margin: 0; padding-bottom: 56px; max-width: 24em; font: 500 clamp(22px, 2.4vw, 30px)/1.25 "Bricolage Grotesque", sans-serif; }
  .hero img { aspect-ratio: 4/5; object-fit: cover; object-position: 50% 12%; margin-bottom: -56px; position: relative; }
  .about { display: grid; grid-template-columns: 1.6fr 1fr; gap: 56px; padding-block: 64px 72px; }
  .about p { margin: 0 0 16px; max-width: 37em; }
  .cta { display: inline-block; padding: 10px 20px; background: var(--violet); color: #fff; border-radius: 99px; font-weight: 600; font-size: 15px; text-decoration: none; }
  .cta:hover { background: #453c6b; }
  .lavender { background: var(--lav); }
  .cols { display: grid; grid-template-columns: 1fr 1.9fr; gap: 56px; padding-block: 60px 68px; }
  h2 { margin: 0 0 22px; font: 700 34px/1 "Bricolage Grotesque", sans-serif; letter-spacing: -.02em; }
  .news p { margin: 0 0 16px; padding: 18px 20px; background: #fff; border-radius: 0 22px 0 22px; font-size: 16.5px; line-height: 1.42; }
  ol.talks { margin: 0 0 24px; padding: 0; list-style: none; }
  .talks li { display: grid; grid-template-columns: 118px 1fr; gap: 18px; padding: 12px 0; border-top: 1.5px solid var(--violet); font-size: 17px; line-height: 1.32; }
  .talks time { font-weight: 600; font-size: 14.5px; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .talks small { display: block; margin-top: 2px; color: var(--soft); font-size: 14.5px; }
  .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  figure { position: relative; margin: 0; }
  .strip img { aspect-ratio: 4/3; object-fit: cover; object-position: 50% 25%; }
  figcaption { position: absolute; left: 0; bottom: 0; padding: 5px 12px; background: var(--lime); font-size: 14px; font-weight: 600; }
  footer.wrap { display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; padding-block: 26px 70px; font-size: 15px; }
  @media (max-width: 800px) {
    .wrap { padding: 0 20px; }
    .hero, .about, .cols { grid-template-columns: 1fr; gap: 28px; }
    .hero img { margin-bottom: 0; max-width: 300px; }
    h1 { padding-bottom: 0; }
    .hero { padding-bottom: 28px; }
    .about { padding-block: 40px; }
    .talks li { grid-template-columns: 1fr; gap: 2px; }
    .strip { grid-template-columns: 1fr 1fr; }
    .strip figure:last-child { display: none; }
  }
</style>
</head>
<body>
  <div class="band">
    <div class="wrap">
      <header class="top">
        <span class="tag">Researcher · Educator · Musician</span>
        <nav class="menu">{nav.map(([l, h]) => <a href={h}>{l}</a>)}</nav>
      </header>
      <section class="hero">
        <div>
          <a class="name" href="/try/c">Luc<br />Nijs</a>
          <h1>{lead}</h1>
        </div>
        <img src={portrait} alt="Luc Nijs holding a clarinet" />
      </section>
    </div>
  </div>
  <main>
    <section class="wrap about">
      <div>{intro.map((p) => <p set:html={p} />)}<a class="cta" href="/aboutlucnijs">Read more</a></div>
    </section>
    <section class="lavender">
      <div class="wrap cols">
        <div class="news"><h2>News</h2>{news.map((n) => <p set:html={n} />)}</div>
        <div>
          <h2>Invited lectures</h2>
          <ol class="talks">{lectures.map(([d, t, w]) => <li><time>{d}</time><span>{t}<small>{w}</small></span></li>)}</ol>
          <a class="cta" href="/agenda">See all lectures and workshops</a>
        </div>
      </div>
    </section>
    <section class="strip">{photos.map(([s, c]) => <figure><img src={s} alt={c} loading="lazy" /><figcaption>{c}</figcaption></figure>)}</section>
  </main>
  <footer class="wrap">
    <span>© 2024 by Luc Nijs</span>
    <span>{links.map(([l, h], i) => <>{i > 0 && ' · '}<a href={h} target="_blank" rel="noopener">{l}</a></>)}</span>
  </footer>
  <Switch at="C" />
</body>
</html>
