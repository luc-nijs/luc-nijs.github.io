---
import Base from '../../layouts/Base.astro';
import HeroPhotos from '../../components/HeroPhotos.astro';
import UpcomingLectures from '../../components/UpcomingLectures.astro';
import '../../styles/home.css';
import { focus, intro, news } from '../../data/home.js';

const FONTS = {
  inter: { label: 'Inter', head: 'Inter', body: 'Inter', weight: 300, css: 'Inter:wght@300;400;500;600' },
  manrope: { label: 'Manrope', head: 'Manrope', body: 'Manrope', weight: 300, css: 'Manrope:wght@300;400;500;600' },
  'dm-serif': { label: 'DM Serif Display', head: 'DM Serif Display', body: 'Inter', weight: 400, css: 'DM+Serif+Display&family=Inter:wght@400;500;600' },
  outfit: { label: 'Outfit', head: 'Outfit', body: 'Outfit', weight: 300, css: 'Outfit:wght@300;400;500;600' },
  fraunces: { label: 'Fraunces', head: 'Fraunces', body: 'Inter', weight: 300, css: 'Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500;600' },
};

export function getStaticPaths() {
  return ['inter', 'manrope', 'dm-serif', 'outfit', 'fraunces'].map((font) => ({ params: { font } }));
}

const { font } = Astro.params;
const f = FONTS[font];
---
<Base title={`Font trial: ${f.label}`} description="" slug="">
<link href={`https://fonts.googleapis.com/css2?family=${f.css}&display=swap`} rel="stylesheet" />
<style is:inline set:html={`:root{--head:'${f.head}',serif;--body:'${f.body}',sans-serif}.home h1{font-weight:${f.weight}}.home h2{font-weight:400}
.font-switch{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);z-index:50;display:flex;flex-wrap:wrap;justify-content:center;gap:2px;padding:4px;background:#000;border:1px solid #444;border-radius:8px;font:13px/1 system-ui,sans-serif}
.font-switch a{padding:8px 10px;border-radius:5px;color:#ccc;text-decoration:none}.font-switch a.on{background:#fff;color:#111}`} />
<div class="home">
  <section class="hero">
    <div class="wrap">
      <h1>Luc Nijs</h1>
      <p class="kicker">Researcher · Educator · Musician</p>
    </div>
  </section>
  <div class="wrap">
    <section class="about">
      <HeroPhotos />
      <div><p set:html={intro[0]} /><p set:html={focus} /></div>
      <div><p set:html={intro[1]} /><p set:html={intro[2]} /><a class="more" href="/aboutlucnijs">More about me →</a></div>
    </section>
    <section class="panels">
      <div class="panel news"><h2>News</h2>{news.map((n) => <p set:html={n} />)}</div>
      <div class="panel">
        <h2>Upcoming lectures</h2>
        <UpcomingLectures />
        <a class="more" href="/agenda">See all lectures and workshops →</a>
      </div>
    </section>
  </div>
</div>
<nav class="font-switch" aria-label="Font trials">
  {Object.entries(FONTS).map(([k, v]) => <a href={`/try/${k}`} class={k === font ? 'on' : ''}>{v.label}</a>)}
  <a href="/">Current</a>
</nav>
</Base>
