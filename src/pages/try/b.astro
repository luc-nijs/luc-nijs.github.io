---
import Switch from '../../try/Switch.astro';
import HeroPhotos from '../../try/HeroPhotos.astro';
import { nav, focus, intro, news, lectures, links } from '../../try/content.js';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Option B: Dark</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..600;1,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style is:global>
  :root { --head: 'Inter Tight', sans-serif; --body: Inter, sans-serif; --bg: #131316; --panel: #1c1c21; --text: #ecebe6; --soft: #a3a2a8; --line: #2e2e35; --lime: #cdd14a; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 16.5px/1.6 var(--body); }
  a { color: inherit; text-underline-offset: 3px; }
  a:hover { color: var(--lime); }
  img { display: block; width: 100%; }
  strong { font-weight: 600; color: #fff; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 36px; }
  header.top { display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: flex-end; align-items: baseline; padding-block: 26px; }
  .menu { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; color: var(--text); }
  .menu a { text-decoration: none; }
  .hero { position: relative; min-height: 500px; display: flex; align-items: flex-end; overflow: hidden; }
  .hero .fade { position: absolute; top: 0; right: max(36px, calc((100vw - 1200px) / 2 + 36px)); width: 38%; max-width: 460px; height: 100%; background: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 84%, transparent), linear-gradient(to bottom, transparent, #000 14%, #000 74%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 24%, #000 84%, transparent), linear-gradient(to bottom, transparent, #000 14%, #000 74%, transparent);
    mask-composite: intersect; }
  .hero .fade figcaption { right: 20%; bottom: 16%; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none; display: none; }
  .hero .wrap { position: relative; z-index: 2; width: 100%; padding-block: 40px 44px; }
  .kicker { margin: 18px 0 0; color: var(--lime); font-size: 13px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 0; font: 300 clamp(52px, 7.2vw, 92px)/1 var(--head); letter-spacing: -.025em; }
  .about { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; padding-block: 44px 72px; color: #d2d1cc; font-size: 16px; }
  .about p { margin: 0; }
  .about p + p { margin-top: 14px; }
  .more { display: inline-block; margin-top: 16px; color: var(--lime); font-weight: 500; font-size: 15px; text-decoration: none; }
  .panels { display: grid; grid-template-columns: 1fr 1.8fr; gap: 16px; }
  .panel { padding: 34px 36px; background: var(--panel); border-radius: 4px; }
  h2 { margin: 0 0 22px; font: 400 26px var(--head); }
  .news p { margin: 0 0 18px; font-size: 16px; line-height: 1.5; color: #d2d1cc; }
  ol.talks { margin: 0; padding: 0; list-style: none; }
  .talks li { display: grid; grid-template-columns: 112px 1fr; gap: 20px; padding: 12px 0; border-top: 1px solid var(--line); font-size: 15.5px; line-height: 1.4; }
  .talks time { color: var(--lime); font-size: 13px; line-height: 1.7; font-variant-numeric: tabular-nums; }
  .talks small { display: block; margin-top: 2px; color: var(--soft); font-size: 13px; }
  footer.wrap { display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; margin-top: 72px; padding-block: 26px 70px; border-top: 1px solid var(--line); color: var(--soft); font-size: 14px; }
  @media (max-width: 860px) {
    .wrap { padding: 0 20px; }
    .hero { display: block; min-height: 0; }
    .hero .fade { position: relative; right: auto; width: 100%; max-width: none; height: 340px;
      -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent); -webkit-mask-composite: source-over;
      mask-image: linear-gradient(to bottom, #000 70%, transparent); mask-composite: add; }
    .hero .fade figcaption { right: 12px; bottom: 24%; }
    .hero::after { display: none; }
    .hero .wrap { padding-block: 30px 20px; }
    .about, .panels { grid-template-columns: 1fr; gap: 20px; }
    .panel { padding: 26px 22px; }
    .talks li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
</head>
<body>
  <header class="top wrap">
    <nav class="menu">{nav.map(([l, h]) => <a href={h}>{l}</a>)}</nav>
  </header>
  <section class="hero">
    <HeroPhotos />
    <div class="wrap">
      <h1>Luc Nijs</h1>
      <p class="kicker">Researcher · Educator · Musician</p>
    </div>
  </section>
  <main class="wrap">
    <section class="about">
      <p set:html={intro[0]} />
      <div><p set:html={focus} /><p set:html={intro[1]} /></div>
      <p set:html={intro[2]} />
    </section>
    <section class="panels">
      <div class="panel news"><h2>News</h2>{news.map((n) => <p set:html={n} />)}<a class="more" href="/aboutlucnijs">More about me →</a></div>
      <div class="panel">
        <h2>Invited lectures</h2>
        <ol class="talks">{lectures.map(([d, t, w, x]) => <li><time>{d}</time><span>{t}<small>{w}</small>{x && <small set:html={x} />}</span></li>)}</ol>
        <a class="more" href="/agenda">See all lectures and workshops →</a>
      </div>
    </section>
  </main>
  <footer class="wrap">
    <span>© 2024 by Luc Nijs</span>
    <span>{links.map(([l, h], i) => <>{i > 0 && ' · '}<a href={h} target="_blank" rel="noopener">{l}</a></>)}</span>
  </footer>
  <Switch at="B" />
</body>
</html>
