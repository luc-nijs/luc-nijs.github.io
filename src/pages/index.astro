---
import Base from '../layouts/Base.astro';
import HeroPhotos from '../components/HeroPhotos.astro';
import '../styles/home.css';
import UpcomingLectures from '../components/UpcomingLectures.astro';
import { focus, intro, news } from '../data/home.js';
---
<Base title={"Luc Nijs | Music Education Researcher, Educator and Musician"} description={"Luc Nijs is Associate Professor in Early Childhood Music Education at the University of Luxembourg, researching movement-based instrumental music learning."} slug="">
<div class="home">
  <section class="hero">
    <div class="wrap">
      <h1>Luc Nijs</h1>
      <p class="kicker">Researcher · Educator · Musician</p>
    </div>
  </section>
  <div class="wrap">
    <section class="about">
      <HeroPhotos />
      <div><p set:html={intro[0]} /><p set:html={focus} /></div>
      <div><p set:html={intro[1]} /><p set:html={intro[2]} /><a class="more" href="/aboutlucnijs">More about me<span class="go" aria-hidden="true"></span></a></div>
    </section>
    <section class="panels">
      <div class="panel news"><h2>News</h2>{news.map((n) => <p set:html={n} />)}</div>
      <div class="panel">
        <h2>Upcoming lectures</h2>
        <UpcomingLectures />
        <a class="more" href="/agenda">See all lectures and workshops<span class="go" aria-hidden="true"></span></a>
      </div>
    </section>
  </div>
</div>
</Base>
