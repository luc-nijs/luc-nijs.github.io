---
import Base from '../layouts/Base.astro';
import HeroPhotos from '../components/HeroPhotos.astro';
import '../styles/home.css';
import { focus, intro, news, lectures } from '../data/home.js';
---
<Base title="Luc Nijs ⎸ Music Education Research" description="This is the homepage of the personal website of Luc Nijs, Associate Professor @ University of Luxembourg. This site is about music educational research and practice." slug="">
<div class="home">
  <section class="hero">
    <div class="wrap">
      <h1>Luc Nijs</h1>
      <p class="kicker">Researcher · Educator · Musician</p>
    </div>
  </section>
  <div class="wrap">
    <section class="about">
      <HeroPhotos />
      <div><p set:html={intro[0]} /><p set:html={focus} /></div>
      <div><p set:html={intro[1]} /><p set:html={intro[2]} /><a class="more" href="/aboutlucnijs">More about me →</a></div>
    </section>
    <section class="panels">
      <div class="panel news"><h2>News</h2>{news.map((n) => <p set:html={n} />)}</div>
      <div class="panel">
        <h2>Invited lectures</h2>
        <ol class="talks">{lectures.map(([d, t, w, x]) => <li><time>{d}</time><span>{t}<small>{w}</small>{x && <small set:html={x} />}</span></li>)}</ol>
        <a class="more" href="/agenda">See all lectures and workshops →</a>
      </div>
    </section>
  </div>
</div>
</Base>
